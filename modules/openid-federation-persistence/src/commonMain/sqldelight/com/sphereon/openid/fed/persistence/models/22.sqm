CREATE TABLE TrustMarkOwner (
    id UUID AS kotlin.String DEFAULT gen_random_uuid() PRIMARY KEY,
    trust_mark_type_id UUID AS kotlin.String NOT NULL,
    owner_identifier TEXT NOT NULL,
    jwks TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    deleted_at TIMESTAMP,
    CONSTRAINT FK_TrustMarkOwnerType FOREIGN KEY (trust_mark_type_id) REFERENCES TrustMarkType (id) ON DELETE CASCADE
);

CREATE UNIQUE INDEX unique_trustmarkowner_type_active
ON TrustMarkOwner (trust_mark_type_id)
WHERE deleted_at IS NULL;

ALTER TABLE TrustMarkType ADD COLUMN delegation TEXT;
