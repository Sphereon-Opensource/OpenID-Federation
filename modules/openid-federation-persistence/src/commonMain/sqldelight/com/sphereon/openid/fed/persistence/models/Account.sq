findAll:
SELECT *
FROM Account
WHERE deleted_at IS NULL;

create:
INSERT INTO Account (username, identifier)
VALUES (?, ?)
RETURNING *;

delete:
UPDATE Account
SET deleted_at = CURRENT_TIMESTAMP
WHERE id = ?
RETURNING *;

findByUsername:
SELECT *
FROM Account
WHERE username = ?
AND deleted_at IS NULL;

findById:
SELECT *
FROM Account
WHERE id = ?
AND deleted_at IS NULL;

ensureTenantExists:
INSERT INTO Account (id, username, tenant_source)
VALUES (:id, :username, :tenant_source)
ON CONFLICT (id) DO NOTHING;

findTenantById:
SELECT id FROM Account WHERE id = ? AND deleted_at IS NULL;
