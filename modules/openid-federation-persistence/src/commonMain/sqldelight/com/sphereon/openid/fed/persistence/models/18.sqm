CREATE TABLE TrustAnchorHint (
    id UUID AS kotlin.String DEFAULT gen_random_uuid() PRIMARY KEY,
    account_id UUID AS kotlin.String NOT NULL,
    identifier TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    deleted_at TIMESTAMP,
    CONSTRAINT FK_ParentTrustAnchorHint FOREIGN KEY (account_id) REFERENCES Account (id)
);
CREATE INDEX trust_anchor_hint_account_id_index ON TrustAnchorHint (account_id);
CREATE UNIQUE INDEX unique_account_trust_anchor_hint_identifier_active
    ON TrustAnchorHint (account_id, identifier) WHERE deleted_at IS NULL;
