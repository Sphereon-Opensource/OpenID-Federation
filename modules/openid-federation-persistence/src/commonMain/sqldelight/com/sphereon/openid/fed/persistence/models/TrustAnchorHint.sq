create:
INSERT INTO TrustAnchorHint (
    account_id,
    identifier
) VALUES (?, ?)
RETURNING *;

delete:
UPDATE TrustAnchorHint
SET deleted_at = CURRENT_TIMESTAMP
WHERE id = ?
AND deleted_at IS NULL
RETURNING *;

findByAccountId:
SELECT *
FROM TrustAnchorHint
WHERE account_id = ?
AND deleted_at IS NULL;

findByAccountIdAndId:
SELECT *
FROM TrustAnchorHint
WHERE account_id = ?
AND id = ?
AND deleted_at IS NULL;

findByAccountIdAndIdentifier:
SELECT *
FROM TrustAnchorHint
WHERE account_id = ?
AND identifier = ?
AND deleted_at IS NULL;
