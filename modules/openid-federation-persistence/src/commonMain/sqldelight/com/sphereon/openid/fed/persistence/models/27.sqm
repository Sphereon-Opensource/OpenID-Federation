-- Administration revisions and exact public artifacts commit together. Existing federation rows remain intact.
CREATE TABLE AdminDocument (
    account_id TEXT NOT NULL,
    collection TEXT NOT NULL,
    resource_id TEXT NOT NULL,
    subject_id TEXT NOT NULL DEFAULT '',
    document TEXT NOT NULL,
    etag TEXT NOT NULL,
    updated_at BIGINT NOT NULL,
    artifact TEXT,
    PRIMARY KEY (account_id, collection, resource_id, subject_id)
);
CREATE INDEX admin_document_collection ON AdminDocument(account_id, collection, resource_id);
-- Global bounded scheduled-key polling must not scan every account publication/history row.
CREATE INDEX admin_document_maintenance_queue ON AdminDocument(collection, updated_at, account_id, resource_id);
