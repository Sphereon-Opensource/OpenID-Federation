CREATE TABLE ForeignSubordinateStatement (
    id UUID AS kotlin.String DEFAULT gen_random_uuid() PRIMARY KEY,
    account_id UUID AS kotlin.String NOT NULL,
    iss TEXT NOT NULL,
    sub TEXT NOT NULL,
    statement TEXT NOT NULL,
    expires_at BIGINT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT FK_ForeignSubordinateStatementAccount FOREIGN KEY (account_id) REFERENCES Account (id)
);
CREATE INDEX foreign_subordinate_statement_account_iss_sub_index
    ON ForeignSubordinateStatement (account_id, iss, sub);
