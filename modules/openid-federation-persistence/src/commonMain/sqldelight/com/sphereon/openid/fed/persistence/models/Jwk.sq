create:
INSERT INTO Jwk (
    account_id,
    alg,
    kid,
    kms,
    kms_key_ref,
    key
) VALUES (?, ?, ?, ?, ?, ?)
RETURNING *;

revoke:
UPDATE Jwk
SET revoked_at = CURRENT_TIMESTAMP,
    expires_at = COALESCE(expires_at, CURRENT_TIMESTAMP),
    revocation_reason = ?,
    revoked_reason = ?
WHERE id = ? AND revoked_at IS NULL
RETURNING *;

-- A revocation time can only move earlier and never into the future of the database clock.
updateRevocation:
UPDATE Jwk
SET revocation_reason = :reason, revoked_at = LEAST(revoked_at, COALESCE(CAST(:revokedAt AS TIMESTAMP), revoked_at))
WHERE id = :id AND revoked_at IS NOT NULL
AND (CAST(:revokedAt AS TIMESTAMP) IS NULL OR CAST(:revokedAt AS TIMESTAMP) <= CURRENT_TIMESTAMP)
RETURNING *;

retire:
UPDATE Jwk
SET expires_at = CURRENT_TIMESTAMP
WHERE id = ? AND revoked_at IS NULL
AND (expires_at IS NULL OR expires_at > CURRENT_TIMESTAMP)
RETURNING *;

findByAccountId:
SELECT *
FROM Jwk
WHERE account_id = ?
AND revoked_at IS NULL
AND (expires_at IS NULL OR expires_at > CURRENT_TIMESTAMP)
ORDER BY created_at DESC;

findHistoricalByAccountId:
SELECT *
FROM Jwk
WHERE account_id = ?
AND (revoked_at IS NOT NULL OR expires_at <= CURRENT_TIMESTAMP)
ORDER BY created_at DESC;

-- All managed keys, including revoked and expired keys.
findAllByAccountId:
SELECT *
FROM Jwk
WHERE account_id = ?
ORDER BY created_at DESC;

findById:
SELECT *
FROM Jwk
WHERE id = ?;

findActiveById:
SELECT *
FROM Jwk
WHERE id = ? AND revoked_at IS NULL
AND (expires_at IS NULL OR expires_at > CURRENT_TIMESTAMP);

findByAccountAndKmsKeyRef:
SELECT *
FROM Jwk
WHERE account_id = ?
AND kms_key_ref = ?;
