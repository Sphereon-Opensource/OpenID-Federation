create:
INSERT INTO Jwk (
    account_id,
    alg,
    kid,
    kms,
    kms_key_ref,
    key
) VALUES (?, ?, ?, ?, ?, ?)
RETURNING *;

revoke:
UPDATE Jwk
SET revoked_reason = ?, revoked_at = CURRENT_TIMESTAMP
WHERE id = ?
RETURNING *;

findByAccountId:
SELECT *
FROM Jwk
WHERE account_id = ?
AND revoked_at IS NULL
ORDER BY created_at DESC;

-- All keys including revoked (for federation historical-keys endpoint, OIDFed 1.1 §8.7)
findAllByAccountId:
SELECT *
FROM Jwk
WHERE account_id = ?
ORDER BY created_at DESC;

findById:
SELECT *
FROM Jwk
WHERE id = ?;

findByAccountAndKmsKeyRef:
SELECT *
FROM Jwk
WHERE account_id = ?
AND kms_key_ref = ?;
