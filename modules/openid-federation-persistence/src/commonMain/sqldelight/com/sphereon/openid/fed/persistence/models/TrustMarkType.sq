create:
INSERT INTO TrustMarkType (identifier, account_id)
VALUES (:identifier, :account_id)
RETURNING *;

findByAccountId:
SELECT * FROM TrustMarkType WHERE account_id = :account_id AND deleted_at IS NULL;

findByAccountIdAndId:
SELECT * FROM TrustMarkType
WHERE account_id = :account_id AND id = :id AND deleted_at IS NULL;

findByAccountIdAndIdentifier:
SELECT * FROM TrustMarkType
WHERE account_id = :account_id AND identifier = :identifier AND deleted_at IS NULL;

delete:
UPDATE TrustMarkType
SET deleted_at = CURRENT_TIMESTAMP
WHERE id = :id AND deleted_at IS NULL
RETURNING *;

setDelegation:
UPDATE TrustMarkType
SET delegation = :delegation, updated_at = CURRENT_TIMESTAMP
WHERE account_id = :account_id AND id = :id AND deleted_at IS NULL
RETURNING *;

findByIdentifier:
SELECT * FROM TrustMarkType
WHERE identifier = :identifier AND deleted_at IS NULL;

createWithDefinition:
INSERT INTO TrustMarkType (identifier, account_id, definition)
VALUES (:identifier, :account_id, :definition)
RETURNING *;

updateDefinition:
UPDATE TrustMarkType
SET definition = :definition, version = version + 1, updated_at = CURRENT_TIMESTAMP
WHERE account_id = :account_id AND id = :id AND version = :expected_version AND deleted_at IS NULL
RETURNING *;

findByAccountIdAndIdIncludingDeleted:
SELECT * FROM TrustMarkType
WHERE account_id = :account_id AND id = :id;

insertRevision:
INSERT INTO TrustMarkTypeRevision (trust_mark_type_id, version, definition)
VALUES (:trust_mark_type_id, :version, :definition)
RETURNING *;

findRevisionsByTypeId:
SELECT * FROM TrustMarkTypeRevision
WHERE trust_mark_type_id = :trust_mark_type_id
ORDER BY version ASC;

-- Administration projects the owning record, including the last revoked incarnation.
findLatestByAccountAndIdentifier:
SELECT * FROM TrustMarkType
WHERE account_id = :account_id AND identifier = :identifier
ORDER BY CASE WHEN deleted_at IS NULL THEN 0 ELSE 1 END, created_at DESC, id DESC
LIMIT 1;

findLatestByAccountAndIdentifierForUpdate:
SELECT * FROM TrustMarkType
WHERE account_id = :account_id AND identifier = :identifier
ORDER BY CASE WHEN deleted_at IS NULL THEN 0 ELSE 1 END, created_at DESC, id DESC
LIMIT 1 FOR UPDATE;

findAllByAccountIdIncludingDeleted:
SELECT * FROM TrustMarkType WHERE account_id = :account_id
ORDER BY CASE WHEN deleted_at IS NULL THEN 0 ELSE 1 END, created_at DESC, id DESC;
