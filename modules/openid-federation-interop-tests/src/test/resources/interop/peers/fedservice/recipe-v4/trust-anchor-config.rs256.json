{
  "logging": {
    "version": 1,
    "disable_existing_loggers": false,
    "root": {
      "handlers": [
        "console"
      ],
      "level": "WARNING"
    },
    "handlers": {
      "console": {
        "class": "logging.StreamHandler",
        "stream": "ext://sys.stdout"
      }
    }
  },
  "entity": {
    "entity_id": "https://fedservice.test:7003",
    "entity_type": {
      "federation_entity": {
        "httpc_params": {
          "verify": "/run/peer-ca/ca-bundle.pem",
          "allow_redirects": false
        },
        "key_config": {
          "private_path": "/var/lib/fedservice/private/fed_keys.json",
          "key_defs": [
            {
              "type": "RSA",
              "use": [
                "sig"
              ]
            },
            {
              "crv": "P-256",
              "type": "EC",
              "use": [
                "sig"
              ]
            }
          ],
          "public_path": "/var/lib/fedservice/public/fed_keys.json",
          "read_only": false
        },
        "endpoint": [
          "fetch",
          "list",
          "entity_configuration",
          "resolve"
        ],
        "subordinate": {
          "class": "idpyoidc.storage.abfile.AbstractFileSystem",
          "kwargs": {
            "fdir": "/var/lib/fedservice/subordinates",
            "key_conv": "idpyoidc.util.Base64",
            "value_conv": "idpyoidc.util.JSON"
          }
        }
      }
    }
  },
  "webserver": {
    "server_cert": "/run/tls/server.crt",
    "server_key": "/run/tls/server.key",
    "cert_chain": null,
    "port": 7003,
    "domain": "0.0.0.0",
    "debug": false
  }
}
